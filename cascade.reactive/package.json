{
  "name": "@liquefy/cascade.reactive",
  "version": "1.0.1",
  "description": "Temporal signals: reactive programming with ES6 proxies, where readers and writers of the same data are ordered in time. The reactive engine of Cascade.",
  "keywords": [
    "reactive",
    "signals",
    "temporal signals",
    "proxy",
    "observable",
    "state management",
    "cascade"
  ],
  "author": "Robert Renbris",
  "license": "ISC",
  "type": "module",
  "main": "./dist/cascade.reactive.umd.cjs",
  "module": "./src/cascade.js",
  "exports": {
    ".": {
      "import": "./src/cascade.js",
      "require": "./dist/cascade.reactive.umd.cjs"
    }
  },
  "files": [
    "src",
    "!src/test",
    "!src/experiments",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "mocha ./src/test",
    "build": "vite build",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/erobwen/liquefy.git",
    "directory": "cascade.reactive"
  },
  "bugs": {
    "url": "https://github.com/erobwen/liquefy/issues"
  },
  "homepage": "https://github.com/erobwen/liquefy/tree/main/cascade.reactive#readme",
  "devDependencies": {
    "eslint": "^6.8.0",
    "mobx": "^5.15.4",
    "mocha": "^10.8.2",
    "vite": "^5.3.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
