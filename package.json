{
  "name": "liquefy",
  "private": true,
  "version": "1.0.0",
  "description": "The liquefy monorepo: Cascade, a reactive front end framework built on temporal signals - and Flow, the generation before it.",
  "author": "Robert Renbris",
  "license": "ISC",
  "workspaces": [
    "cascade.reactive",
    "cascade.component",
    "cascade.DOM",
    "cascade.ui",
    "cascade.ui.material",
    "cascade.application/demo",
    "causality",
    "flow.core",
    "flow.DOM",
    "flow",
    "flow.ui/basic",
    "flow.ui/themed",
    "flow.ui/material",
    "flow.ui/modern",
    "flow.application/demo",
    "flow.application/hello-world",
    "flow.application/experiments"
  ],
  "scripts": {
    "test": "npm test --workspaces --if-present",
    "build": "npm run build -w @liquefy/causality -w @liquefy/cascade.reactive",
    "demo": "npm start -w @liquefy/cascade-demo",
    "build:demo": "npm run build -w @liquefy/cascade-demo",
    "flow:demo": "npm start -w @liquefy/flow-demo",
    "build:site": "node scripts/build-site.mjs",
    "release:check": "node scripts/publish-new-versions.mjs --dry-run"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/erobwen/liquefy.git"
  },
  "bugs": {
    "url": "https://github.com/erobwen/liquefy/issues"
  },
  "homepage": "https://github.com/erobwen/liquefy#readme",
  "keywords": [
    "javascript",
    "proxy",
    "reactive",
    "signals",
    "temporal signals",
    "front end",
    "framework"
  ]
}
