      "optional": true
    },
    "@liquefy/cascade.dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "mocha": "^10.8.2",
    "jsdom": "^24.1.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
